name: Build Ginkgo NetHunter Kernel

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 120
    steps:
      - name: Checkout kernel source
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Install build dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y git curl bison flex python3 gzip tar xz-utils \
            make gcc perl gawk swig pkg-config zstd device-tree-compiler bc \
            libssl-dev libncurses-dev

      - name: Run build script
        run: |
          chmod +x build.sh dtc
          yes | ./build.sh

      - name: Upload kernel zip
        uses: actions/upload-artifact@v4
        with:
          name: ginkgo-nethunter-kernel
          path: |
            ../*.zip
            *.tar.gz
          if-no-files-found: warn

      - name: Upload logs on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: build-logs
          path: |
            .config
            *.log
